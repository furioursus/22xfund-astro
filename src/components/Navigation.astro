---
import { Image } from "astro:assets";
import Logo from "/src/assets/menu-logo.png";
import IconMenu from "/src/assets/icon-menu.png";
// A null `link` renders the item as an inert button rather than an anchor.
// "Register Here" and "Login" originally pointed at live Securitize
// authorization flows; they lead nowhere in this portfolio reproduction.
let nav = [
	{
		name: "Companies",
		link: "/#companies",
	},
	{
		name: "About",
		link: "/#about-us",
	},
	{
		name: "Team",
		link: "/#team",
	},
	{
		name: "FAQ",
		link: "/faq",
	},
	{
		name: "Register Here",
		link: null,
	},
	{
		name: "Login",
		link: null,
	},
];

const linkClass =
	"block px-6 py-3 no-underline uppercase text-pickled-bluewood md:p-0";
const inertClass =
	"block px-6 py-3 uppercase cursor-not-allowed text-regent-gray md:p-0";
const inertTitle = "Disabled in this portfolio reproduction";
---

<nav class="sticky top-0 left-0 right-0 z-40 w-full bg-white">
	<div
		class="container relative z-50 flex items-center justify-between w-full p-4 mx-auto bg-white"
	>
		<a
			href="#top"
			class="block h-12"
		>
			<Image
				src={Logo}
				alt="22X Fund Logo"
				class="h-12 w-12"
			/>
		</a><a
			id="mobile-nav-trigger"
			href=""
			class="block p-2 bg-white rounded-xs md:hidden"
		>
			<Image
				src={IconMenu}
				alt="Mobile Navigation Button"
				class="block h-4 w-4"
			/>
		</a>
		<ul
			class="justify-end flex-1 hidden text-sm font-semibold list-reset md:flex md:items-center"
		>
			{
				nav.map(({ name, link }) => (
					<li class="md:ml-4">
						{link ? (
							<a href={link} class={linkClass}>
								{name}
							</a>
						) : (
							<span aria-disabled="true" title={inertTitle} class={inertClass}>
								{name}
							</span>
						)}
					</li>
				))
			}
		</ul>
	</div>
	<div
		id="mobile-nav"
		class="absolute top-0 z-30 w-full duration-300 transform -translate-y-full bg-white md:hidden"
	>
		<div class="container py-3 mx-auto">
			<ul class="block text-sm font-semibold list-reset">
				{
					nav.map(({ name, link }) => (
						<li class="md:ml-4">
							{link ? (
								<a href={link} class={linkClass}>
									{name}
								</a>
							) : (
								<span aria-disabled="true" title={inertTitle} class={inertClass}>
									{name}
								</span>
							)}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</nav>
